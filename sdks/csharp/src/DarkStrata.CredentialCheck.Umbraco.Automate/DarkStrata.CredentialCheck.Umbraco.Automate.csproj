<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Umbraco Automate ships for net10.0 only. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Automate's and Umbraco's dependency graphs carry transitive advisories we cannot pin. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- NuGet Package Metadata -->
    <PackageId>DarkStrata.CredentialCheck.Umbraco.Automate</PackageId>
    <Version>2.9.0</Version>
    <Authors>DarkStrata</Authors>
    <Company>DarkStrata</Company>
    <Title>DarkStrata Credential Check for Umbraco Automate</Title>
    <Description>Adds a "Compromised Credential Detected" trigger to Umbraco Automate, so a member or backoffice login or password change using stolen credentials can start an automation. Requires DarkStrata.CredentialCheck.Umbraco.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/darkstrata/darkstrata-sdks</PackageProjectUrl>
    <RepositoryUrl>https://github.com/darkstrata/darkstrata-sdks</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>umbraco-marketplace;umbraco;umbraco-automate;security;credentials;infostealer;stealer-logs;password</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <Copyright>Copyright (c) DarkStrata</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DarkStrata.CredentialCheck.Umbraco.Automate.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Automate 18.x needs Umbraco 18, which DarkStrata.CredentialCheck.Umbraco does not support yet. -->
    <PackageReference Include="Umbraco.Automate.Core" Version="[17.0.0,18.0.0)" />
    <ProjectReference Include="../DarkStrata.CredentialCheck.Umbraco/DarkStrata.CredentialCheck.Umbraco.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="../DarkStrata.CredentialCheck.Umbraco/icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
